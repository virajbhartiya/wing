{
  "manifest_version": 3,
  "name": "Wing Spaces",
  "version": "0.2.0",
  "description": "Local workspaces, a calm new tab, and a native Chromium sidebar for Wing.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "chrome_url_overrides": {
    "newtab": "home.html"
  },
  "action": {
    "default_title": "Open Wing Spaces",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Wing Spaces"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "incognito": "not_allowed"
}
