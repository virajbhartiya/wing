{
  "manifest_version": 3,
  "name": "Wing browser services",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "downloads",
    "history",
    "bookmarks",
    "contentSettings",
    "browsingData",
    "management",
    "storage",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
